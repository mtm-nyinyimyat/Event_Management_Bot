// Event bot database — document-centric RAG on Prisma Postgres + pgvector.
// Vectors are Unsupported("vector"); the app reads/writes them via `pg` + raw SQL.
// Prisma Studio: non-vector tables work; rag_chunks may fail on the embedding column.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations / Studio / db pull must use the direct host (db.prisma.io), not the pooler.
  directUrl = env("DIRECT_URL")
  extensions = [vector]
}

model Conversation {
  id             BigInt @id @default(autoincrement())
  conversationId String @map("conversation_id")
  role           String
  name           String
  content        String
  activityId     String @map("activity_id")
  timestamp      String
  blob           Json

  @@index([conversationId], map: "idx_conversations_conversation_id")
  @@index([conversationId, timestamp], map: "idx_conversations_timestamp")
  @@map("conversations")
}

model Feedback {
  id        BigInt   @id @default(autoincrement())
  replyToId String   @map("reply_to_id")
  reaction  String
  feedback  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([replyToId], map: "idx_feedback_reply_to_id")
  @@map("feedback")
}

/// Durable Excel / event file identity. RAG vectors hang off this, not the chat.
model RagDocument {
  id          String   @id @default(uuid())
  sourceType  String   @map("source_type")
  sourceUri   String   @map("source_uri")
  fileName    String?  @map("file_name")
  contentHash String?  @map("content_hash")
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions   EventSession[]
  meta       RagMeta?
  chunks     RagChunk[]
  sharepoint RagSharepointSource?

  @@index([status], map: "idx_rag_documents_status")
  @@index([contentHash], map: "idx_rag_documents_content_hash")
  @@map("rag_documents")
}

/// Graph / SharePoint sync state for a document (production URL ingest).
model RagSharepointSource {
  documentId              String    @id @map("document_id")
  driveId                 String?   @map("drive_id")
  itemId                  String?   @map("item_id")
  siteId                  String?   @map("site_id")
  webUrl                  String?   @map("web_url")
  subscriptionId          String?   @map("subscription_id")
  subscriptionExpiresAt   DateTime? @map("subscription_expires_at") @db.Timestamptz(6)
  deltaLink               String?   @map("delta_link")
  etag                    String?
  lastModifiedAt          DateTime? @map("last_modified_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  document RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([driveId, itemId], map: "uq_rag_sharepoint_drive_item")
  @@map("rag_sharepoint_sources")
}

/// Chat-scoped event lifecycle; points at the active document when status=active.
model EventSession {
  conversationId String    @id @map("conversation_id")
  documentId     String?   @map("document_id")
  status         String
  pendingUrls    Json      @default("[]") @map("pending_urls")
  activeSource   String?   @map("active_source")
  activeFileName String?   @map("active_file_name")
  startedBy      String?   @map("started_by")
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  document RagDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([documentId], map: "idx_event_sessions_document_id")
  @@index([status], map: "idx_event_sessions_status")
  @@map("event_sessions")
}

model RagMeta {
  documentId String   @id @map("document_id")
  fingerprint String
  provider   String
  model      String
  dims       Int
  chunkCount Int      @map("chunk_count")
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  document RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("rag_meta")
}

model RagChunk {
  documentId String                       @map("document_id")
  chunkId    String                       @map("chunk_id")
  sheet      String
  text       String
  rowJson    Json                         @map("row_json")
  embedding  Unsupported("vector(384)")
  dims       Int

  document RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, chunkId])
  @@index([documentId, sheet], map: "idx_rag_chunks_sheet")
  @@map("rag_chunks")
}
